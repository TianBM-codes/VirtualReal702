    {
      "name": "新版",
      "base_url": "http://127.0.0.1:5000",
      "project_id": "benchmark_new",
      "repo_path": "..",
      "env": {
        "APP_FAST_BDF_MIN_BYTES": "1"
      }
    }
  ],
  "sources": {
    "bdf_path": "D:/models/test.bdf",
    "op2_path": "D:/models/test.op2"
  },
  "benchmark": {
    "include_op2": true,
    "include_color_details": true,
    "repeat": 5,
    "frame": 0,
    "frame_colors_field": "U",
    "frame_colors_component": "U1",
    "frame_colors_modes": ["smooth", "flat"],
    "color_code_schemes": ["etype", "material", "section_type", "section", "section_assignment"],
    "scale": 1.0,
    "n_frames": 4,
    "timeout_seconds": 1800,
    "poll_seconds": 1.0,
    "watch_timeout_seconds": 7200,
    "output_dir": "../benchmark_results",
    "delete_existing_project": true,
    "delete_project_after": true,
    "result_group": "benchmark_op2"
  },
  "automation": {
    "repository_path": "..",
    "runtime_root": "D:/Temp/VirtualReal702-benchmark",
    "startup_timeout_seconds": 180,
    "runner_poll_seconds": 1,
    "between_versions_seconds": 2
  }
}
