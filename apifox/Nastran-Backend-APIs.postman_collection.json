              "raw": "{\n  \"input_bdf\": \"D:/demo/model.bdf\",\n  \"settings\": {\n    \"dynamic.fmin\": 0.0,\n    \"dynamic.fmax\": 1000.0,\n    \"dynamic.vectors\": 20,\n    \"dynamic.norm\": 2,\n    \"dynamic.size\": 0,\n    \"compute.lumped\": true,\n    \"fem.k6rot\": -1.0\n  }\n}"
