{
  "openapi": "3.0.3",
  "info": {
    "title": "VirtualReal702 Model Update Solver And Sensitivity API",
    "version": "1.0.0",
    "description": "模型修正主线新增的本地求解器调用与灵敏度 VTU 导出接口，可直接导入 Apifox。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5000",
      "description": "Local FastAPI server"
    }
  ],
  "paths": {
    "/tools/inp/tree": {
      "post": {
        "tags": [
          "model-update"
        ],
        "summary": "解析 INP 模型树并返回结构化结果",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InpTreeRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "file_path": "D:/models/door.inp",
                    "show_labels": true,
                    "max_labels": 8
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/sensitivity/export/vtu": {
      "post": {
        "tags": [
          "sensitivity"
        ],
        "summary": "导出 DSA 灵敏度结果为 VTU（兼容入口）",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SensitivityExportDsaVtuRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "project_id": 1001,
                    "odb_id": "door-odb",
                    "output_vtu": "D:/runs/door_dsa.vtu",
                    "base_url": "http://127.0.0.1:18765",
                    "step": "Step-1",
                    "instances": [
                      "PART-1-1"
                    ],
                    "field_prefix": "d_UR_",
                    "position": "INTEGRATION_POINT",
                    "aggregation": "max_abs",
                    "frame": 0,
                    "timeout": 60
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/sensitivity/export/vtu/dsa": {
      "post": {
        "tags": [
          "sensitivity"
        ],
        "summary": "导出 DSA 灵敏度结果为 VTU",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SensitivityExportDsaVtuRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "project_id": 1001,
                    "odb_id": "door-odb",
                    "output_vtu": "D:/runs/door_dsa.vtu",
                    "base_url": "http://127.0.0.1:18765",
                    "step": "Step-1",
                    "instances": [
                      "PART-1-1"
                    ],
                    "field_prefix": "d_UR_",
                    "position": "INTEGRATION_POINT",
                    "aggregation": "max_abs",
                    "frame": 0,
                    "timeout": 60
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/sensitivity/export/vtu/adjoint": {
      "post": {
        "tags": [
          "sensitivity"
        ],
        "summary": "导出 Adjoint 灵敏度结果为 VTU",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SensitivityExportAdjointVtuRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "project_id": 1001,
                    "odb_id": "shell-odb",
                    "output_vtu": "D:/runs/shell_adjoint.vtu",
                    "base_url": "http://127.0.0.1:18765",
                    "step": "Step-1",
                    "instances": [
                      "PART-1-1"
                    ],
                    "field_name": "S",
                    "position": "INTEGRATION_POINT",
                    "aggregation": "max_abs",
                    "frame": 0,
                    "timeout": 60
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/solver/deck_solver/sensitivity": {
      "post": {
        "tags": [
          "solver"
        ],
        "summary": "运行 DeckSolver 材料参数灵敏度流程",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeckSolverSensitivityRunRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "input_inp": "D:/models/door.inp",
                    "output_dir": "D:/runs/door_sensitivity",
                    "response_elset": "EALL",
                    "response_nset": "NRESP",
                    "response_frequency": 1,
                    "node_vars": [
                      "U",
                      "RF"
                    ],
                    "element_vars": [
                      "S"
                    ],
                    "deck_solver": "deck_solver",
                    "job_name": "door_sensitivity",
                    "cpus": 4,
                    "interactive": true,
                    "run_solver": true,
                    "timeout_sec": 7200,
                    "extra_args": [
                      "memory=8gb"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/solver/deck_solver/adjoint": {
      "post": {
        "tags": [
          "solver"
        ],
        "summary": "运行 DeckSolver 壳厚度 Adjoint 灵敏度流程",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeckSolverAdjointRunRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "input_inp": "D:/models/shell_panel.inp",
                    "output_inp": "D:/runs/shell_panel_adjoint.inp",
                    "response_nset": "NRESP",
                    "deck_solver": "deck_solver",
                    "job_name": "shell_panel_adjoint",
                    "cpus": 4,
                    "interactive": true,
                    "run_solver": true,
                    "timeout_sec": 7200,
                    "extra_args": [
                      "memory=8gb"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/solver/bulk_solver/sol103": {
      "post": {
        "tags": [
          "solver"
        ],
        "summary": "转换并运行 BulkSolver SOL103 模态流程",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkSolverSol103RunRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "input_bdf": "D:/models/engine.bdf",
                    "output_bdf": "D:/runs/engine_sol103.bdf",
                    "settings": {
                      "dynamic.fmin": 0.0,
                      "dynamic.fmax": 1000.0,
                      "dynamic.vectors": 20,
                      "dynamic.norm": 2,
                      "compute.lumped": true
                    },
                    "bulk_solver": "bulk_solver",
                    "run_solver": true,
                    "timeout_sec": 7200,
                    "extra_args": [
                      "scr=yes"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericApiResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InpTreeRequest": {
        "type": "object",
        "required": [
          "file_path"
        ],
        "properties": {
          "file_path": {
            "type": "string"
          },
          "show_labels": {
            "type": "boolean",
            "default": true
          },
          "max_labels": {
            "type": "integer",
            "default": 8
          }
        }
      },
      "SensitivityExportVtuBaseRequest": {
        "type": "object",
        "required": [
          "project_id",
          "output_vtu"
        ],
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "odb_id": {
            "type": "string"
          },
          "output_vtu": {
            "type": "string"
          },
          "base_url": {
            "type": "string"
          },
          "inp_path": {
            "type": "string"
          },
          "workspace": {
            "type": "string"
          },
          "odb_path": {
            "type": "string"
          },
          "step": {
            "type": "string"
          },
          "instances": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "position": {
            "type": "string"
          },
          "aggregation": {
            "type": "string",
            "default": "max_abs"
          },
          "frame": {
            "type": "integer",
            "default": 0
          },
          "deck_solver": {
            "type": "string",
            "default": "deck_solver"
          },
          "python3": {
            "type": "string"
          },
          "keep_raw": {
            "type": "boolean",
            "default": false
          },
          "timeout": {
            "type": "integer",
            "default": 60
          }
        }
      },
      "SensitivityExportDsaVtuRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SensitivityExportVtuBaseRequest"
          },
          {
            "type": "object",
            "properties": {
              "field_prefix": {
                "type": "string",
                "default": "d_U_"
              }
            }
          }
        ]
      },
      "SensitivityExportAdjointVtuRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SensitivityExportVtuBaseRequest"
          },
          {
            "type": "object",
            "required": [
              "field_name"
            ],
            "properties": {
              "field_name": {
                "type": "string"
              }
            }
          }
        ]
      },
      "DeckSolverSensitivityRunRequest": {
        "type": "object",
        "required": [
          "input_inp"
        ],
        "properties": {
          "input_inp": {
            "type": "string"
          },
          "output_dir": {
            "type": "string"
          },
          "response_elset": {
            "type": "string"
          },
          "response_nset": {
            "type": "string"
          },
          "response_frequency": {
            "type": "integer",
            "default": 1
          },
          "node_vars": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "element_vars": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deck_solver": {
            "type": "string",
            "default": "deck_solver"
          },
          "job_name": {
            "type": "string"
          },
          "cpus": {
            "type": "integer"
          },
          "interactive": {
            "type": "boolean",
            "default": true
          },
          "run_solver": {
            "type": "boolean",
            "default": true
          },
          "timeout_sec": {
            "type": "integer"
          },
          "extra_args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      },
      "DeckSolverAdjointRunRequest": {
        "type": "object",
        "required": [
          "input_inp"
        ],
        "properties": {
          "input_inp": {
            "type": "string"
          },
          "output_inp": {
            "type": "string"
          },
          "response_nset": {
            "type": "string"
          },
          "deck_solver": {
            "type": "string",
            "default": "deck_solver"
          },
          "job_name": {
            "type": "string"
          },
          "cpus": {
            "type": "integer"
          },
          "interactive": {
            "type": "boolean",
            "default": true
          },
          "run_solver": {
            "type": "boolean",
            "default": true
          },
          "timeout_sec": {
            "type": "integer"
          },
          "extra_args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      },
      "BulkSolverSol103RunRequest": {
        "type": "object",
        "required": [
          "input_bdf"
        ],
        "properties": {
          "input_bdf": {
            "type": "string"
          },
          "output_bdf": {
            "type": "string"
          },
          "settings": {
            "type": "object",
            "additionalProperties": true,
            "default": {}
          },
          "bulk_solver": {
            "type": "string",
            "default": "bulk_solver"
          },
          "run_solver": {
            "type": "boolean",
            "default": true
          },
          "timeout_sec": {
            "type": "integer"
          },
          "extra_args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      },
      "GenericApiResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
